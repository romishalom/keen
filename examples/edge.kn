use <stdio.h>;
use <stdlib.h>;
use <string.h>;

extern {
    fn abs(x: c_int) -> c_int;
}

#[packed]
struct Packed { a: u8, b: u32 }

#[align(16)]
struct Aligned { v: [f32; 4] }

struct Table {
    ops: [fn(i32, i32) -> i32; 3],
    row: *mut [i32; 4],
    name: *const c_char,
    dyn_data: [u8; _],
}

type BinOp = fn(i32, i32) -> i32;

fn add(a: i32, b: i32) -> i32 { a + b }
fn sub(a: i32, b: i32) -> i32 { a - b }
fn mul(a: i32, b: i32) -> i32 { a * b }

fn get_op(which: i32) -> fn(i32, i32) -> i32 {
    match which {
        0 => add,
        1 => sub,
        _ => mul,
    }
}

fn first_row(t: *const [i32; 4]) -> i32 { (*t)[0] }

fn nested_loops() -> i32 {
    let mut hits: i32 = 0;
    'outer: for i in 0..5 {
        let mut j: i32 = 0;
        while j < 5 {
            j += 1;
            match j {
                2 => continue,
                4 => continue 'outer,
                _ => {}
            }
            if i == 3 {
                break 'outer;
            }
            hits += 1;
        }
    }
    hits
}

fn loop_break_in_match() -> i32 {
    let mut n: i32 = 0;
    loop {
        n += 1;
        match n {
            5 => break,
            _ => {}
        }
    }
    n
}

fn counter() -> i32 {
    static mut calls: i32 = 0;
    calls += 1;
    calls
}

fn local_things() -> i32 {
    const BASE: i32 = 40;
    struct Pair { a: i32, b: i32 }
    enum Mode { Fast, Slow }
    type Num = i32;
    let p: Pair = Pair { a: 1, b: 2 };
    let m: Num = Mode::Slow as Num;
    BASE + p.a + p.b + m
}

fn flags() -> u32 {
    let mut f: u32 = 0;
    f |= 1u32 << 3;
    f ^= 0xF0;
    f &= ~0x10;
    f <<= 1;
    f += (f >> 2) % 7;
    return f;
}

fn volatile_ptr(p: *mut volatile u32) -> u32 { *p }

fn pointers(p: *mut *const c_char, n: *const *mut i32) -> bool {
    p != NULL && n != NULL && *p == NULL
}

#[cfg(FAST)]
fn mode() -> i32 { 1 }
#[cfg(not(FAST))]
fn mode() -> i32 { 2 }

fn cast_chain(x: f64) -> i32 {
    let v = x as i64 as i32;
    v + ('a' as i32) - ('\n' as i32)
}

pub fn main() -> i32 {
    let t = Packed { a: 1, b: 2 };
    printf("%zu %zu\n", sizeof(Packed), alignof(Aligned));
    printf("%d %d %d\n", get_op(0)(7, 3), get_op(1)(7, 3), get_op(2)(7, 3));
    let rows: [[i32; 4]; 2] = [[1, 2, 3, 4], [5, 6, 7, 8]];
    printf("row=%d\n", first_row(&rows[1]));
    printf("loops=%d %d\n", nested_loops(), loop_break_in_match());
    printf("static=%d %d\n", counter(), counter());
    printf("local=%d flags=%u\n", local_things(), flags());
    let mut reg: u32 = 77;
    printf("vol=%u mode=%d abs=%d\n", volatile_ptr(&reg), mode(), abs(-9));
    printf("cast=%d t=%d\n", cast_chain(3.9), (t.a as i32) + offsetof(Packed, b) as i32);
    let mut s: *const c_char = NULL;
    let n: *const *mut i32 = NULL;
    printf("ptrs=%d\n", pointers(&s, n) as i32);
    let pt: Aligned = Aligned { v: [1.0f32, 2.0f32, 3.0f32, 4.0f32] };
    printf("%.1f\n", pt.v[2] as f64);
    return 0;
}
